+no_engine_turn = 0.15
+one_engine_speed = 0.8
+no_engine_speed = 0.4
+list_rate = 0.06
+list_hold_deg = 10.0
+screen_range_min = 600.0
+screen_range_max = 950.0
+leash_radius = 900.0
+core_exposure_count = 3
+assault_cross_speed = 90.0
+assault_max_speed = 110.0
+assault_sway_speed = 30.0
