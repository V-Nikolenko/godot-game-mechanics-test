[node name="LaserPhase" type="Node2D" parent="."]
script = ExtResource("7_ss")

; A DIRECT child of SpaceStation, deliberately. bullet_pool.gd:47 hardcodes its container as
; get_parent().get_parent(), so only this placement resolves to enemy_container and puts
; in-flight bullets in world space. Under Gunnery or Turrets it would resolve to the station
; itself, and LaserPhase rotates the hull, so the whole bullet field would swing with it.
;
; pool_size 48: phase 1 peaks at 4 turrets x 3 bullets / 1.8 s = 6.7/s, and a bullet needs ~4.1 s
; to reach the arena bound (~984 px at 240 px/s from the station at world (640, 180)), so ~27 in
; flight. Phase 2 adds 10 per 2.0 s at 210 px/s, ~23 in flight. The phases OVERLAP at the
; handover — turret bullets live ~4.1 s and the first ring lands 2.0 s after armor_broken — so
; the real peak is ~27 leftovers + 10 = ~37, not max(27, 23). 48 leaves ~11 of headroom.
[node name="BulletPool" type="Node" parent="."]
script = ExtResource("8_ss")
bullet_scene = ExtResource("9_ss")
pool_size = 48
metadata/_custom_type_script = "uid://kvgsxhn0cac7"

; node_paths= is REQUIRED. Without it the text scene format leaves the exported node reference
; null, prints no error, and the gate stays green — only the script's get_node_or_null fallback
; would save it.
[node name="Gunnery" type="Node2D" parent="." node_paths=PackedStringArray("bullet_pool")]
script = ExtResource("10_ss")
bullet_pool = NodePath("../BulletPool")

; The fourth sibling behaviour node, after LaserPhase, BulletPool and Gunnery. It spawns
; reinforcement squads as SIBLINGS OF THE STATION (into get_parent(), i.e. the enemy container),
; never as children of it — station_laser_phase.gd:123 rotates the hull, and anything parented
; under the station would be dragged around the arena with it. No node_paths= tag is needed here
; because this node exports no node references; it resolves its parent in _ready().
[node name="Reinforcements" type="Node2D" parent="."]
script = ExtResource("11_ss")

; The fifth sibling behaviour node. Spectacle only: the STATION owns the death timer and calls
; queue_free() on itself (space_station.gd::_finish_death), so deleting or renaming this node
; costs the explosions and nothing else. If it owned the free, a renamed node would hang
; station_assault for its full 180 s timeout with no error.
;
; It exports no node references, so no node_paths= tag is needed — it resolves its parent in
; _ready(). Note it does NOT hold its own ExplosionEffect: that is created at death time and
; parented to the STATION, because explosion_effect.gd resolves its container as
; get_parent().get_parent() and one hop too deep would put every blast inside the rotating hull.
[node name="DeathSequence" type="Node2D" parent="."]
script = ExtResource("12_ss")
